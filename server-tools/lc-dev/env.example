# Picasso Dev LibreChat 环境变量模板（真实 .env 在服务器 /opt/lc-dev/.env 生成，不入库）
# 秘钥用 openssl rand -hex 32 现场生成，与生产完全独立。
HOST=0.0.0.0
PORT=3080
MONGO_URI=mongodb://mongodb:27017/LibreChatDev
SECRET_KEY=<openssl rand -hex 32>
APP_TITLE=畢卡索 Dev
SCHEDULES_SINGLE_PROCESS=true
ALLOW_REGISTRATION=true
EMAIL_ENABLED=false
ALLOW_EMAIL_VERIFICATION=false
CREDS_KEY=<openssl rand -hex 32>
CREDS_IV=<openssl rand -hex 16>
JWT_SECRET=<openssl rand -hex 32>
JWT_REFRESH_SECRET=<openssl rand -hex 32>
